[Unit]
Description=FlashTunnel Client (Xray Reality Relay)
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=/sbin/iptables -t nat -A PREROUTING -p tcp -m multiport --dports 8443,2087,8080 -j REDIRECT --to-ports 443
ExecStart=/usr/local/bin/flashtunnel-bin client --server 1.2.3.4:4433 --listen 0.0.0.0:443 --tcp --key MySecretKey
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
